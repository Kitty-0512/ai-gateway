# =============================================================================
# AI 统一分析网关 - 环境变量模板
# 复制为 .env 并填入实际值
# =============================================================================

# ---- 应用 ----
APP_NAME="Data Agent 智能问数与经营分析平台"
API_PREFIX=/api
CORS_ORIGINS=https://ai-gateway-production-74c4.up.railway.app,http://localhost:3000

# ---- DeepSeek / OpenAI 兼容接口 ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_FALLBACK_MOCK=true

# ---- MySQL（仅 SQL 分析模式需要）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=analyzer
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ai_analyzer
# 连接 TiDB Cloud / Aiven 等托管数据库时必须设为 true（服务端强制 TLS）
MYSQL_SSL_ENABLED=false
# 留空则使用 certifi 内置根证书
MYSQL_SSL_CA=

# ---- 前端静态资源 ----
# 指向前端构建产物目录，存在时由后端一并托管（单服务部署）
STATIC_DIR=static

# ---- 日志诊断 ----
MAX_LOG_CHARS=12000
MAX_UPLOAD_BYTES=2097152
